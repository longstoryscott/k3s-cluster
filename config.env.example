# Cluster Configuration Template
# Copy this file to config.env and fill in your values
# config.env is gitignored and will not be committed

# Domain Configuration
DOMAIN_BASE="example.com"
AUTH_DOMAIN="auth.${DOMAIN_BASE}"
DDNS_DOMAIN="mynetwork.ddns-provider.com"

# Network Configuration
MASTER_NODE_IP="192.168.1.100"
REGISTRY_IP="${MASTER_NODE_IP}"
REGISTRY_PORT="31500"

# Private IP ranges (space-separated)
TRUSTED_PROXY_IPS="192.168.1.100 192.168.1.101 192.168.1.102"

# Service Ports
GRAFANA_PORT="3001"
PROMETHEUS_PORT="9090"
REGISTRY_UI_PORT="31501"
NEXTCLOUD_PORT="3000"
AUTH_PORT="9091"
SEARXNG_PORT="8086"
DESKTOP_PORT="8087"

# Database Configuration (optional - can use generated secrets instead)
# POSTGRES_PASSWORD=""
# MYSQL_ROOT_PASSWORD=""
